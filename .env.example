# ==============================================================================
# Spotify Discovery Engine — Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env or expose secret keys in version control.
# ==============================================================================

# 1. Groq Cloud LLM API Key (Required for classify.py, classify_backfill.py, backend.py)
# Models used: llama-3.3-70b-versatile (primary), llama-3.1-8b-instant (fallback)
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 2. Supabase PostgreSQL Database (Required for database storage and test_db.py)
# Project URL (e.g., https://yourprojectref.supabase.co)
SUPABASE_URL=your_supabase_project_url_here

# Project API Key (anon/public or service_role key)
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# 3. GitHub Actions Integration (Optional: Used by Streamlit app for workflow dispatch & polling)
# Personal access token with repo / workflow permissions: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub repository in owner/repo format:
GITHUB_REPO=pbehuray/spotify-discovery-engine

# Groq model (optional - defaults to llama-3.3-70b-versatile, or set to openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b
